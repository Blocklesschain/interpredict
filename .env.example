# InterPredict V2 — Environment Configuration
# Version: 2.0.0 | Deployed: 2026-08-17

# =============================================================================
# 1. PUBLIC (NEXT_PUBLIC_* — safe for browser bundle)
# =============================================================================
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0B688f6A747ea16b16Ea8E27a4Fad54025e96FCb
NEXT_PUBLIC_CHAIN_ID=19042026
NEXT_PUBLIC_RPC_URL=https://evm-rpc.test-net.interlinklabs.ai/v1/rpc

# =============================================================================
# 2. SERVER SECRETS (never bundled to browser)
# =============================================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# --- InterLink RPC Auth ---
INTERLINK_RPC_URL=https://evm-rpc.test-net.interlinklabs.ai/v1/rpc
INTERLINK_BACKEND_PRIVATE_KEY=your_backend_wallet_private_key

# --- Service Wallet (for indexer / keeper transactions) ---
SERVICE_WALLET_PRIVATE_KEY=your_service_wallet_private_key

# --- Contract (server-side) ---
CONTRACT_ADDRESS=0x0B688f6A747ea16b16Ea8E27a4Fad54025e96FCb

# --- Indexer ---
INDEXER_SECRET=your_indexer_secret
INDEXER_START_BLOCK=0
INDEXER_BATCH_SIZE=500
INDEXER_CONFIRMATION_DEPTH=3

# --- Keeper / Cron ---
CRON_SECRET=your_cron_secret_for_keeper_route
